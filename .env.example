FREE_CONSOLE_PORT=8866
FREE_CONSOLE_PASSWORD=
FREE_CONSOLE_THREADS=8
TZ=Asia/Shanghai
FREE_CONSOLE_TIMEZONE=Asia/Shanghai

# Managed proxy pool
PROXY_HOST=
PROXY_PORT=10000
PROXY_USER=
PROXY_PASS=

# Browser mode uses local browser hosts when configured.
BITBROWSER_API=http://127.0.0.1:54345
ROXY_API_PORT=50000
ROXY_API_TOKEN=
ROXY_WORKSPACE_ID=
ROXY_API_RATE_LIMIT=45
CHROME_PATH=

# Optional schema-v3 receive-only domain mailbox provider config.
# Keep admin tokens outside source control; the JSON may reference a local
# secret file through admin_token_file/admin_token_json_key.
DOMAIN_MAILBOX_CONFIG=data/cloudflare-mailbox.json
